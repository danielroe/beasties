{
  "name": "beasties",
  "version": "0.5.5",
  "description": "Inline critical CSS and lazy-load the rest.",
  "author": "The Chromium Authors",
  "contributors": [
    {
      "name": "Jason Miller",
      "email": "developit@google.com"
    },
    {
      "name": "Janicklas Ralph",
      "email": "janicklas@google.com"
    },
    {
      "name": "Daniel Roe",
      "email": "daniel@roe.dev",
      "url": "https://roe.dev"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielroe/beasties",
    "directory": "packages/beasties"
  },
  "keywords": [
    "critical css",
    "inline css",
    "critical",
    "beasties",
    "webpack plugin",
    "performance"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./compiler": "./dist/compiler.mjs",
    "./runtime": "./dist/runtime.mjs"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "docs": "documentation readme src -q --no-markdown-toc -a public -s Usage --sort-order alpha",
    "prepack": "npm run -s build"
  },
  "dependencies": {
    "css-select": "^7.0.0",
    "css-what": "^8.0.0",
    "dom-serializer": "^3.0.0",
    "domhandler": "^6.0.0",
    "htmlparser2": "^12.0.0",
    "picocolors": "^1.1.1",
    "postcss": "^8.4.49",
    "postcss-media-query-parser": "^0.2.3",
    "postcss-safe-parser": "^7.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.1",
    "@types/postcss-media-query-parser": "0.2.5",
    "documentation": "14.0.3",
    "publint": "^0.3.8",
    "tsdown": "0.23.7"
  }
}
